# Production Environment Configuration (VPS / Ubuntu)
# Copy to .env on the server and fill in real values:
#   cp .env.production .env && nano .env

# App
NODE_ENV=production
PORT=4040
ALLOWED_ORIGINS=*
# Shared service key (x-api-key header on POST /) — generate a strong random string
COMMON_X_API_KEY=change_this_to_a_secure_random_string

# Database (local PostgreSQL on the VPS)
DATABASE_URL=postgresql://momo:CHANGE_THIS_PASSWORD@localhost:5432/payment_service?schema=public

# Redis (local Redis on the VPS)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_min_32_chars_for_production
JWT_EXPIRES_IN=8h

# Admin seed (used once: node --env-file=.env dist/prisma/seed.js)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# Throttle
THROTTLE_TTL=60000
THROTTLE_LIMIT=60

# Payment providers are DB-backed, NOT env vars. After first boot, configure via admin commands:
#   ADM_SETRTE_5I7K  -> routing (default/collection/disbursement: mtn | xentry)
#   ADM_SETXTR_1P3R  -> Xentry baseUrl / apiKey / webhookSecret
#   ADM_SETMTN_9X1Z  -> MTN environment / keys
# XentriPay inbound webhook URL to register with Xentry:
#   https://<your-domain-or-ip>:4040/webhooks/providers/xentripay
