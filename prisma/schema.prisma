generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id               String        @id @default(uuid())
  email            String        @unique
  passwordHash     String
  twoFactorSecret  String?
  twoFactorEnabled Boolean       @default(false)
  lastLoginAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  actions          AdminAction[]

  @@map("admins")
}

model AdminAction {
  id         String   @id @default(uuid())
  adminId    String
  action     String
  targetType String
  targetId   String
  note       String?
  createdAt  DateTime @default(now())
  admin      Admin    @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([targetType, targetId])
  @@map("admin_actions")
}

model TenantApp {
  id          String              @id @default(uuid())
  name        String
  email       String              @unique
  webhookUrl     String?
  webhookSecret  String?
  status         TenantStatus        @default(PENDING)
  itecAccountType ItecAccountType   @default(NORMAL)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  apiKeys     ApiKey[]
  batches     DisbursementBatch[]
  collections Collection[]
  webhookLogs WebhookLog[]

  @@map("tenant_apps")
}

enum ItecAccountType {
  NORMAL
  MERCHANT
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REVOKED
}

enum PaymentProvider {
  ITEC
  MTN
  XENTRY
}

model ProviderFeeConfig {
  id        String          @id @default(uuid())
  provider  PaymentProvider @unique
  fixedFee  Int             @default(0)
  enabled   Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@map("provider_fee_configs")
}

/// Global ITEC Pay settings per account type, managed from the admin dashboard.
/// apiUrl includes the API version path (e.g. https://pay.itecpay.rw/api2).
model ItecPayConfig {
  id          String          @id @default(uuid())
  accountType ItecAccountType @unique
  apiUrl      String
  apiKey      String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("itec_pay_configs")
}

/// Which provider handles each flow (was PAYMENT_PROVIDER_* env vars) — singleton row.
model PaymentRoutingConfig {
  id                   String           @id @default("main")
  defaultProvider      PaymentProvider  @default(ITEC)
  collectionProvider   PaymentProvider?
  disbursementProvider PaymentProvider?
  withdrawProvider     PaymentProvider?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@map("payment_routing_configs")
}

/// Xentry (XentriPay) settings — singleton row, admin-configurable.
model XentryPayConfig {
  id            String   @id @default("main")
  baseUrl       String   @default("https://merchant.test.xentripay.com")
  apiKey        String   @default("")
  webhookSecret String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("xentry_pay_configs")
}

/// MTN MoMo settings (direct API) — singleton row, admin-configurable.
model MtnPayConfig {
  id              String   @id @default("main")
  baseUrl         String   @default("")
  subscriptionKey String   @default("")
  apiUser         String   @default("")
  apiKey          String   @default("")
  environment     String   @default("sandbox")
  callbackUrl     String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("mtn_pay_configs")
}

model ApiKey {
  id        String       @id @default(uuid())
  tenantId  String
  key       String       @unique
  status    ApiKeyStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  revokedAt DateTime?
  tenant    TenantApp    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("api_keys")
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
}

model DisbursementBatch {
  id             String            @id @default(uuid())
  tenantId       String
  idempotencyKey String?
  provider       PaymentProvider   @default(ITEC)
  userPseudoId   String
  senderPhone    String
  totalAmount    Int
  totalCharges   Int
  chargeReceiver String
  providerFee    Int               @default(0)
  totalCharged   Int               @default(0)
  status         BatchStatus       @default(PENDING)
  isWithdraw     Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  tenant         TenantApp         @relation(fields: [tenantId], references: [id])
  jobs           DisbursementJob[]
  webhookLogs    WebhookLog[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([idempotencyKey])
  @@index([userPseudoId])
  @@index([senderPhone])
  @@index([status])
  @@index([isWithdraw, createdAt])
  @@map("disbursement_batches")
}

enum BatchStatus {
  PENDING
  PROCESSING
  COMPLETED
  PARTIALLY_FAILED
}

model DisbursementJob {
  id           String            @id @default(uuid())
  batchId      String
  phone        String
  amount       Int
  jobType      JobType
  providerFee  Int               @default(0)
  totalCharged Int               @default(0)
  status       JobStatus         @default(QUEUED)
  mtnRef       String?
  /// Recipient account name as validated by the provider (Xentry validatedAccountName).
  recipientName String?
  /// Registered account name parsed from a provider name-mismatch rejection
  /// (Xentry "Correct Registered name is : ..."); tenants use it to correct beneficiary data.
  validatedRecipientName String?
  failReason   String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  batch        DisbursementBatch @relation(fields: [batchId], references: [id])

  @@index([batchId])
  @@index([status])
  @@map("disbursement_jobs")
}

enum JobType {
  PAYOUT
  CHARGE
}

enum JobStatus {
  QUEUED
  PROCESSING
  SUCCESS
  FAILED
}

model Collection {
  id             String           @id @default(uuid())
  tenantId       String
  idempotencyKey String?
  provider       PaymentProvider  @default(ITEC)
  userPseudoId   String
  phone          String
  amount         Int
  status         CollectionStatus @default(QUEUED)
  mtnRef         String?
  failReason     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  tenant         TenantApp        @relation(fields: [tenantId], references: [id])
  webhookLog     WebhookLog?

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([userPseudoId])
  @@index([phone])
  @@index([status])
  @@map("collections")
}

enum CollectionStatus {
  QUEUED
  PROCESSING
  SUCCESS
  FAILED
}

model WebhookLog {
  id            String             @id @default(uuid())
  batchId       String?
  collectionId  String?            @unique
  tenantId      String
  url           String
  payload       Json
  status        WebhookStatus      @default(PENDING)
  attempts      Int                @default(0)
  lastAttemptAt DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  batch         DisbursementBatch? @relation(fields: [batchId], references: [id])
  collection    Collection?        @relation(fields: [collectionId], references: [id])
  tenant        TenantApp          @relation(fields: [tenantId], references: [id])

  @@unique([batchId])
  @@index([tenantId])
  @@index([status])
  @@map("webhook_logs")
}

enum WebhookStatus {
  PENDING
  SUCCESS
  FAILED
  RETRYING
}

/// Inbound provider webhook deliveries (XentriPay -> us), deduped by idempotency key.
/// This model exists only in this deployment (not in the arvash schema).
model ProviderWebhookEvent {
  id                String    @id @default(uuid())
  provider          String
  idempotencyKey    String
  eventType         String?
  payload           Json
  signatureVerified Boolean   @default(false)
  processedAt       DateTime?
  createdAt         DateTime  @default(now())

  @@unique([provider, idempotencyKey])
  @@index([createdAt])
  @@map("provider_webhook_events")
}
