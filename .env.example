# App
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
COMMON_X_API_KEY=1223qwe123

# Database
DATABASE_URL=postgresql://momo:secret@localhost:5432/momo_db?schema=public
POSTGRES_USER=momo
POSTGRES_PASSWORD=secret
POSTGRES_DB=momo_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redissecret

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_min_32_chars
JWT_EXPIRES_IN=8h

# Provider settings are stored in the database, not in env:
#   ADM_SETMTN_9X1Z  -> MTN MoMo credentials
#   ADM_SETXTR_1P3R  -> Xentry (XentriPay) baseUrl / apiKey / webhookSecret
#   ADM_SETRTE_5I7K  -> active provider per flow (mtn | xentry)
# Legacy MTN_* env vars are no longer read.

# Seeding
RUN_SEED=false
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=StrongPassword123!

# Throttle
THROTTLE_TTL=60000
THROTTLE_LIMIT=60
